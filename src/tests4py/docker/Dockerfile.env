# syntax=docker/dockerfile:1
#
# Layer 1 of 3 -- the ENVIRONMENT image.
#
# A reusable base shared by every project and every bug: an OS with the CPython
# build toolchain, pyenv, and Tests4Py itself installed from the local source
# (so any local changes -- e.g. the merge-commit checkout fix -- are baked in).
#
# Build context MUST be the repository root:
#   docker build -f src/tests4py/docker/Dockerfile.env -t tests4py-env:latest .
#
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYENV_ROOT=/root/.pyenv \
    PATH=/root/.pyenv/bin:/root/.pyenv/shims:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin

# Toolchain to build CPython via pyenv, plus git/curl for checkouts.
RUN apt-get update && apt-get install -y --no-install-recommends \
        make build-essential ca-certificates curl git wget \
        libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
        libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev \
        libffi-dev liblzma-dev llvm \
    && rm -rf /var/lib/apt/lists/*

# pyenv (Tests4Py drives per-project virtualenvs through it).
RUN curl -fsSL https://pyenv.run | bash

# A default interpreter so Tests4Py itself can run; individual projects install
# their own pinned version into this same pyenv at build time.
ARG DEFAULT_PYTHON=3.10.9
RUN pyenv install "${DEFAULT_PYTHON}" && pyenv global "${DEFAULT_PYTHON}"

# Install Tests4Py from the local source (editable) -> local fixes are included.
WORKDIR /opt/tests4py
COPY . /opt/tests4py
RUN pip install --upgrade pip && pip install -e .

# Cache built projects/venvs inside the image layers so children reuse them.
RUN t4p config cache True

WORKDIR /work
CMD ["bash"]
